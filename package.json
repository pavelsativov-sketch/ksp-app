{
  "name": "ksp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "cf:build": "wrangler deploy --dry-run --config wrangler.proxy.jsonc",
    "cf:deploy": "wrangler deploy --config wrangler.proxy.jsonc",
    "cf:dry-run": "wrangler deploy --dry-run --config wrangler.proxy.jsonc",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:ai": "node scripts/benchmark-ai.mjs",
